#!/usr/bin/env bash
# Regenerate everything derived from spec/openapi.yaml + spec/sdk-manifest.yaml:
#   - src/anchorbrowser/types/models.py   (response models, datamodel-code-generator)
#   - src/anchorbrowser/types/params.py   (request TypedDicts, datamodel-code-generator)
#   - src/anchorbrowser/types/__init__.py (re-exports)
#   - src/anchorbrowser/resources/*.py    (resource classes, scripts/generate_resources.py)
#
# Usage: ./scripts/generate            regenerate in place
#        ./scripts/generate --check    regenerate and fail if anything changed (CI)

set -euo pipefail
cd "$(dirname "$0")/.."

PY="${PYTHON:-.venv/bin/python}"
if [ ! -x "$PY" ]; then PY="$(command -v python3)"; fi
DCG="$(dirname "$PY")/datamodel-codegen"
if [ ! -x "$DCG" ]; then DCG="$(command -v datamodel-codegen)"; fi

TYPES_DIR=src/anchorbrowser/types
rm -rf "$TYPES_DIR"
mkdir -p "$TYPES_DIR"

# hoist inline response schemas into named components (see scripts/preprocess_spec.py)
GEN_TMP="$(mktemp -d)"
trap 'rm -rf "$GEN_TMP"' EXIT
"$PY" scripts/preprocess_spec.py --out "$GEN_TMP/openapi.yaml"

COMMON=(
  --input "$GEN_TMP/openapi.yaml"
  --input-file-type openapi
  --target-python-version 3.10
  --use-double-quotes
  --disable-timestamp
  --enum-field-as-literal all
  --field-constraints
  --formatters ruff-format
)

# the pyright directive covers dict-key constraints (patternProperties), which
# datamodel-code-generator can only express as a constr() call in the annotation
"$DCG" "${COMMON[@]}" \
  --output "$TYPES_DIR/models.py" \
  --output-model-type pydantic_v2.BaseModel \
  --base-class anchorbrowser._models.BaseModel \
  --snake-case-field \
  --custom-file-header "# Generated by scripts/generate from spec/openapi.yaml — do not edit.
# pyright: reportInvalidTypeForm=false
# mypy: disable-error-code=valid-type"

"$DCG" "${COMMON[@]}" \
  --output "$TYPES_DIR/params.py" \
  --output-model-type typing.TypedDict \
  --custom-file-header "# Generated by scripts/generate from spec/openapi.yaml — do not edit."

cat > "$TYPES_DIR/__init__.py" <<'PYEOF'
# Generated by scripts/generate from spec/openapi.yaml — do not edit.
from . import params as params
from .models import *  # noqa: F403
PYEOF

"$PY" scripts/generate_resources.py --spec "$GEN_TMP/openapi.yaml"

# format everything we just wrote with the repo's formatter
if [ -x "$(dirname "$PY")/ruff" ]; then
  "$(dirname "$PY")/ruff" format --quiet "$TYPES_DIR" src/anchorbrowser/resources
  "$(dirname "$PY")/ruff" check --quiet --fix-only "$TYPES_DIR" src/anchorbrowser/resources || true
fi

if [ "${1:-}" = "--check" ]; then
  # git status --porcelain (not git diff) so brand-new untracked generated files also fail the check
  CHANGES=$(git status --porcelain -- "$TYPES_DIR" src/anchorbrowser/resources spec/)
  if [ -n "$CHANGES" ]; then
    echo "$CHANGES"
    git --no-pager diff -- "$TYPES_DIR" src/anchorbrowser/resources spec/ || true
    echo "::error::Generated code is stale — run ./scripts/generate and commit the result."
    exit 1
  fi
  echo "generate --check: up to date"
fi
